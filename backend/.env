# Symfony Configuration
APP_ENV=dev
APP_SECRET=changeme_generate_a_secret_key_here

# Database Configuration
# For MySQL: DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/pourcha?serverVersion=8.0"
# For PostgreSQL: DATABASE_URL="postgresql://db_user:db_password@127.0.0.1:5432/pourcha?serverVersion=15&charset=utf8"
DATABASE_URL="mysql://root:password@127.0.0.1:3306/pourcha?serverVersion=8.0"

# JWT Configuration
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=changeme

# CORS Configuration
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal Configuration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Crypto Payment Configuration
# NowPayments API (optional for automated crypto processing)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret

# Manual Crypto Wallet Addresses
CRYPTO_WALLET_BTC=your_btc_wallet_address
CRYPTO_WALLET_USDT_SOLANA=your_usdt_solana_address
CRYPTO_WALLET_USDC_SOLANA=your_usdc_solana_address
CRYPTO_WALLET_MONERO=your_monero_wallet_address

# Plan Pricing (in cents for Stripe)
PLAN_PRO_MONTHLY_PRICE=999
PLAN_PRO_YEARLY_PRICE=9900

# Multi-Tenancy
TENANT_DOMAIN=.pourcha.app

# Application URL (for OAuth callbacks)
APP_URL=https://app.pourcha.com

# External Integrations

# Xero Integration
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_REDIRECT_URI=https://app.pourcha.com/api/integrations/xero/callback

# QuickBooks Integration
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REDIRECT_URI=https://app.pourcha.com/api/integrations/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# SAP Integration
# SAP uses custom API URLs per customer installation
# Configure via integration settings in the app

# Plaid Integration (Bank Linking)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox
